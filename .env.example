# Copy to .env and fill in. Never commit .env.

# SQLite locally; a postgres:// URL in deployment (switch the provider in prisma/schema.prisma).
DATABASE_URL="file:./data/policy-tracker.db"

OPENAI_API_KEY=""
# Low-cost test model for document analysis using relevant passages from the entire PDF.
OPENAI_MODEL="gpt-6-luna"
# Country synthesis and topic tagging also use the low-cost model.
OPENAI_MODEL_CHEAP="gpt-6-luna"
# Low reasoning effort keeps the test inexpensive; increase it when comparing answer quality.
OPENAI_REASONING_EFFORT="low"

# Original PDFs are stored here as <iso3>/<document_id>.pdf.
STORAGE_DIR="./storage"

# Optional application estimate cap. 0 means no cap; provider billing limits still apply.
MAX_USD_PER_RUN="0"

# Jobs the worker runs at the same time. Each country processes one document at a time;
# domain questions within that document and work for other countries may run concurrently.
WORKER_CONCURRENCY="2"

# Set to 1 to run the whole pipeline against a local fake of the OpenAI API (no key, no cost).
# For development and tests only: answers are made up from the page text.
OPENAI_FAKE="0"
