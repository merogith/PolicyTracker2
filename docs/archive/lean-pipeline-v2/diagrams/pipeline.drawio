        <mxCell id="e-note-0" parent="1" value="" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#D7E0EA;strokeWidth=2;shadow=0;">
          <mxGeometry x="1100" y="385" width="620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e-note-0-title" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Two model roles, not a model chain&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#23364D;fontStyle=1;spacing=0;">
          <mxGeometry x="1120" y="403" width="575" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e-note-0-body" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Pooling and scoring are application code.&lt;br/&gt;Retagging is maintenance, not a routine third stage.&lt;br/&gt;No separate judge/scoring model.&lt;br/&gt;Two roles can use the same tested model.&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#23364D;fontStyle=0;spacing=0;">
          <mxGeometry x="1120" y="443" width="575" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e-note-1" parent="1" value="" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#D7E0EA;strokeWidth=2;shadow=0;">
          <mxGeometry x="1100" y="605" width="620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e-note-1-title" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Bounded work, visible limitations&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#23364D;fontStyle=1;spacing=0;">
          <mxGeometry x="1120" y="623" width="575" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e-note-1-body" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;One country-update budget covers retries,&lt;br/&gt;search, repairs and overflow.&lt;br/&gt;Never truncate input and label it complete.&lt;br/&gt;Failed or unreadable work is incomplete,&lt;br/&gt;not evidence that a policy is absent.&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#23364D;fontStyle=0;spacing=0;">
          <mxGeometry x="1120" y="663" width="575" height="133" as="geometry" />
        </mxCell>
        <mxCell id="e-note-2" parent="1" value="" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#D7E0EA;strokeWidth=2;shadow=0;">
          <mxGeometry x="1100" y="865" width="620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e-note-2-title" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Stage 2 preserves meaning&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#23364D;fontStyle=1;spacing=0;">
          <mxGeometry x="1120" y="883" width="575" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e-note-2-body" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;100,000 ha versus comparable 80,000 ha:&lt;br/&gt;retain conflicting target variants.&lt;br/&gt;60,000 ha of existing capacity:&lt;br/&gt;keep a separate contextual claim.&lt;br/&gt;Support never proves target achievement.&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#23364D;fontStyle=0;spacing=0;">
          <mxGeometry x="1120" y="923" width="575" height="133" as="geometry" />
        </mxCell>
        <mxCell id="e-note-3" parent="1" value="" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#D7E0EA;strokeWidth=2;shadow=0;">
          <mxGeometry x="1100" y="1115" width="620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e-note-3-title" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Document and combined views&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#23364D;fontStyle=1;spacing=0;">
          <mxGeometry x="1120" y="1133" width="575" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e-note-3-body" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Each document keeps its own assertions.&lt;br/&gt;Combined views can link evidence across sources.&lt;br/&gt;Historical views exclude future documents.&lt;br/&gt;Four bands are categories, not numbers to average.&lt;br/&gt;Cross-domain display does not double-count topics.&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#23364D;fontStyle=0;spacing=0;">
          <mxGeometry x="1120" y="1173" width="575" height="133" as="geometry" />
        </mxCell>
        <mxCell id="e-note-4" parent="1" value="" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#D7E0EA;strokeWidth=2;shadow=0;">
          <mxGeometry x="1100" y="1375" width="620" height="250" as="geometry" />
        </mxCell>
        <mxCell id="e-note-4-title" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Automatic publication&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#23364D;fontStyle=1;spacing=0;">
          <mxGeometry x="1120" y="1393" width="575" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e-note-4-body" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;No human approval or moderation gate.&lt;br/&gt;Partial snapshots identify unresolved work.&lt;br/&gt;Progress, contradictions and conditions&lt;br/&gt;appear beside the documentation band.&lt;br/&gt;Users flag or hide items after publication.&lt;br/&gt;Hiding does not silently change the benchmark.&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#23364D;fontStyle=0;spacing=0;">
          <mxGeometry x="1120" y="1433" width="575" height="158" as="geometry" />
        </mxCell>
        <mxCell id="e-footer" parent="1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Specification v2.0.0 | Climate and disaster scope | 16 domains / 64 topics | Runtime integration still required&lt;/div&gt;" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#52667B;fontStyle=0;spacing=0;">
          <mxGeometry x="60" y="1671" width="1660" height="33" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>