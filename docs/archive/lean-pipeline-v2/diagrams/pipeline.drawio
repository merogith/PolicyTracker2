          </mxGeometry>
        </mxCell>
        <mxCell id="e-config-to-pool" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#60758A;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
