      "hidden"
    ],
    "flags": [
      "incorrect",
      "duplicate",
      "wrong_topic",
      "outdated",
      "other"
    ],
    "rule": "Store reason, actor, timestamp and claim version separately. A flag does not stop publication. Hiding changes presentation only by default; a custom exclusion produces a labeled adjusted score, leaving the generated regional benchmark intact."
  },
  "delivery_enums": {
