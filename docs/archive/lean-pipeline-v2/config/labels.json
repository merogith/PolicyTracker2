{
  "version": "2.0.0",
  "status": "recommended_specification_not_active",
  "rules": [
    "Only extract labels explicitly supported by the record's own evidence.",
    "One primary topic; secondary topics only for substantive additional subjects.",
    "Empty arrays mean not stated or not extracted, never that the concept does not exist.",
    "Unknown labels go in unmapped_concepts with the source wording; never invent enum values.",
    "No human review_status field. Automatic check states and post-publication user overlays are separate.",
    "Do not reward a record for carrying more labels.",
    "Delivery details require source-linked actor, action timeframe and specific verifiable deliverable for the same coherent response and variant. A broad programme name alone is not shared identity."
  ],
  "statement_type": {
    "required": true,
    "selection": "one",
    "options": [
      {
        "id": "concern",
        "meaning": "A stated risk, vulnerability, impact, need, barrier or gap",
        "response_stage": null
      },
      {
        "id": "context",
        "meaning": "A current or historical condition, capacity or baseline",
        "response_stage": null
      },
      {
        "id": "projection",
        "meaning": "A modeled or expected future condition, not a policy undertaking",
        "response_stage": null
      },
      {
        "id": "commitment",
        "meaning": "An attributable policy goal, priority or target",
        "response_stage": 1
      },
      {
        "id": "planned_action",
        "meaning": "A specific planned measure, programme or instrument",
        "response_stage": 2
      },
      {
        "id": "implementation_underway",
        "meaning": "Explicit implementation, procurement, construction or operation of the identified action",
        "response_stage": 3
      },
      {
        "id": "output_delivered",
        "meaning": "Explicitly completed, installed or adopted output of the identified action",
        "response_stage": 4
      },
      {
        "id": "result_reported",
        "meaning": "A reported outcome or effect; does not by itself prove causation or target achievement",
        "response_stage": null
      },
      {
        "id": "proposal",
        "meaning": "A recommendation without an attributable adopted undertaking",
        "response_stage": null
      },
      {
        "id": "other",
        "meaning": "Relevant sourced statement that no listed type fits",
        "response_stage": null
      }
    ]
  },
  "facets": {
