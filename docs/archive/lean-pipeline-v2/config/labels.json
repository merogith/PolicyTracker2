  "relationship_rule": "Restatement/progress/revision may connect identity members of the same policy object. Supporting/context assertions retain their own identity and score. Supersession requires explicit evidence. Contradiction requires comparable scope and basis.",
  "comparability": [
    "comparable",
    "not_comparable",
    "insufficient_detail"
  ],
