        <mxCell id="d4" value="&lt;b&gt;4  Check + conditional recovery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evidence, unit accounting, omissions&lt;br&gt;Persist records; split exhausted output" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
