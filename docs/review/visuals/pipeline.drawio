        <mxCell id="title" value="Two model stages. One traceable result.&lt;br&gt;Final plan / 20 October 2026 / proposed, not active" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#17374b;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1010" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1  Prepare every source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text + layout + targeted OCR&lt;br&gt;Conditional image recovery" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
          <mxGeometry x="50" y="155" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2  Extract records - LLM 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every packet, across all topics&lt;br&gt;Titles + facts + exact evidence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#e4f3ef;strokeColor=#2b847b;fontColor=#17374b;" vertex="1" parent="1">
          <mxGeometry x="400" y="155" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3  Check and pool - code&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recover omissions / errors&lt;br&gt;Select source scope; retain all" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
          <mxGeometry x="750" y="155" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4  Organize claims - LLM 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Group the same proposition&lt;br&gt;Keep variants, context and links" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#e4f3ef;strokeColor=#2b847b;fontColor=#17374b;" vertex="1" parent="1">
          <mxGeometry x="750" y="345" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5  Calculate scores - code&lt;/b&gt;&lt;br&gt;&lt;br&gt;Four checks per response&lt;br&gt;Topic means + distinct counts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
