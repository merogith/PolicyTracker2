        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;2  Prepare every page + region&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text / layout; local OCR if needed&lt;br&gt;Conditional vision; retain crops" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
