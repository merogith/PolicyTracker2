        <mxCell id="d7" value="&lt;b&gt;7  Organize - LLM 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same proposition, compatible scope&lt;br&gt;Keep conflicts; account every record" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#e4f3ef;strokeColor=#2b847b;fontColor=#17374b;" vertex="1" parent="1">
