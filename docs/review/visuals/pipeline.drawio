        <mxCell id="d6" value="&lt;b&gt;6  Select scope + pool records&lt;/b&gt;&lt;br&gt;&lt;br&gt;Document / current / historical scope&lt;br&gt;Owned records + read-only context" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
