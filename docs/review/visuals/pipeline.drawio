        <mxCell id="title" value="From every selected source to traceable response scores&lt;br&gt;Final engineering plan / scoring 4.0 / presentation 4.1 / no human acceptance gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#17374b;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;1  Freeze source + config manifest&lt;/b&gt;&lt;br&gt;&lt;br&gt;Country, roles, editions, as-of date&lt;br&gt;Exact bundle hashes; fixed run identity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
