        <mxCell id="d8" value="&lt;b&gt;8  Check organization - code&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ownership, references, group boundaries&lt;br&gt;Bounded repair / reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
