        <mxCell id="d5" value="&lt;b&gt;5  Account for selected sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;Complete only when work resolves&lt;br&gt;Publish partial; no completion cutoff" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#abc0cd;fontColor=#17374b;" vertex="1" parent="1">
